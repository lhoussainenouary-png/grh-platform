# =====================================================
# Variables d'environnement - GRH Platform
# =====================================================
# IMPORTANT: Ce fichier contient des données sensibles!
# Ne jamais le partager ou le commit sur Git

# URL du Google Apps Script (formulaire)
GOOGLE_SCRIPT_URL=https://script.google.com/macros/

# URL du Google Sheet (dashboard) - export CSV
CSV_URL=https://docs.google.com/spreadsheets/

# Mot de passe pour accéder au dashboard
PASSWORD=




# Analyse qualitative des questions ouvertes (route API serveur uniquement)
OPENROUTER_API_KEY=sk-or-
# Exemples : openai/gpt-4o-mini, anthropic/claude-3-haiku, etc.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optionnel (certaines clés OpenRouter le demandent)
OPENROUTER_HTTP_REFERER=https://localhost
