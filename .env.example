# URL de déploiement « Application web » Google Apps Script (POST formulaire)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/VOTRE_ID/exec

# URL de publication CSV du Google Sheet (Fichier > Partager > Publier sur le web > CSV)
NEXT_PUBLIC_CSV_URL=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv

# Mot de passe du tableau de bord (exposé côté client — à renforcer en production si besoin)
NEXT_PUBLIC_DASHBOARD_PASSWORD=GESI2026

# Analyse qualitative des questions ouvertes (route API serveur uniquement)
OPENROUTER_API_KEY=
# Exemples : openai/gpt-4o-mini, anthropic/claude-3-haiku, etc.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optionnel (certaines clés OpenRouter le demandent)
OPENROUTER_HTTP_REFERER=https://localhost
